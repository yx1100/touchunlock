{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%@ · firmware %@": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 固件 %@"
          }
        }
      }
    },
    "%lld enrolled.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已录入 %lld 枚。"
          }
        }
      }
    },
    "%lld of %lld": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld / %lld"
          }
        }
      }
    },
    "%lld step(s) left.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还差 %lld 步。"
          }
        }
      }
    },
    "A small panel appears at the top of the screen after the device types a password, and after a manual test from the Fingerprints page. The reader's light blinks slowly while a window is asking for a password, so you know the reader will type when you touch it.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备输入密码之后、以及在指纹页手动测试之后，屏幕顶部会出现一个小提示面板。有窗口在等密码时识别器的灯会慢闪，提示你现在按指纹就会输入。"
          }
        }
      }
    },
    "About": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "Add Fingerprint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加指纹"
          }
        }
      }
    },
    "Add a fingerprint to unlock with a touch.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加指纹后，轻触传感器即可解锁。"
          }
        }
      }
    },
    "Advanced": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高级"
          }
        }
      }
    },
    "Allow Bluetooth for TouchUnlock in Privacy & Security.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“隐私与安全性”中允许触达使用蓝牙。"
          }
        }
      }
    },
    "Allow Device Control and Data Access so TouchUnlock can tell when a window is asking for a password. Without it, a finger press only types at secure password prompts.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请允许「设备控制和数据访问」，触达才能判断前台窗口是不是在等密码。没有这个权限时，只有屏幕上出现安全密码输入提示时按压指纹才会输入。"
          }
        }
      }
    },
    "Allowed": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已允许"
          }
        }
      }
    },
    "Allow…": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许…"
          }
        }
      }
    },
    "Almost done.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "马上就好。"
          }
        }
      }
    },
