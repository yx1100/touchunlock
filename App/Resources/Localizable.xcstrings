    "System Settings → Privacy & Security → Device Control and Data Access. If the switch there is already on, remove TouchUnlock from the list and add it again.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统设置 → 隐私与安全 → 设备控制和数据访问。如果那里的开关已经是打开的，请把列表里的触达移除后重新添加一次。"
          }
        }
      }
    },
