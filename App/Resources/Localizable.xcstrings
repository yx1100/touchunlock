        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "忽略的应用"
          }
        }
      }
    },
    "Lets the app tell when a window is asking for a password. Without it only secure password prompts are recognized.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于判断前台窗口是否在等待密码。未授权时只能识别安全密码输入框。"
          }
        }
      }
    },
    "Linking the Password": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在关联密码"
          }
        }
      }
    },
    "Links new fingerprints and confirms deletions. It never leaves this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于关联新指纹与确认删除操作。不会离开这台 Mac。"
          }
        }
      }
    },
    "Log": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日志"
          }
        }
      }
    },
    "Mac login password": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 登录密码"
          }
        }
      }
    },
    "Make sure the device is powered on.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认设备已通电。"
          }
        }
      }
    },
    "Name": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名字"
          }
        }
      }
    },
    "Needed only when the reader has to learn this Mac again, for example after it was forgotten in Bluetooth settings.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在识别器需要重新认这台 Mac 时使用，例如曾在系统蓝牙中忘记过它。"
          }
        }
      }
    },
    "New fingerprints will no longer link automatically, and deleting one will no longer ask for the password.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新录入的指纹将不再自动关联密码，删除指纹时也不再要求输入密码。"
          }
        }
      }
    },
    "No Fingerprints": {
      "extractionState": "manual",
      "localizations": {
