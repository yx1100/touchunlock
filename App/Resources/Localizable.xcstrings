      }
    },
    "%lld step(s) left.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还差 %lld 步。"
          }
        }
      }
    },
    "A panel appears after the device types a password or a manual test runs. The reader's light blinks while a window is asking for a password.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备输入密码后或手动测试后会显示提示面板。有窗口在等待密码时，识别器指示灯闪烁。"
          }
        }
      }
    },
    "About": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "Add App…": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加应用…"
          }
        }
      }
    },
    "Add Fingerprint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加指纹"
          }
        }
      }
    },
    "Add a fingerprint first.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先添加一枚指纹。"
          }
        }
      }
    },
    "Add a fingerprint to unlock with a touch.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加指纹后，轻触传感器即可解锁。"
          }
        }
      }
    },
    "Advanced": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高级"
          }
        }
      }
    },
    "Allow Bluetooth for TouchUnlock in Privacy & Security.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“隐私与安全性”中允许触达使用蓝牙。"
          }
        }
      }
    },
