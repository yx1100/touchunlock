        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这根手指没有录入。"
          }
        }
      }
    },
    "Touch an enrolled finger to unlock.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触碰已录入的手指即可解锁。"
          }
        }
      }
    },
    "Touch the sensor with this finger to unlock.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用这根手指触碰传感器即可解锁。"
          }
        }
      }
    },
    "Try Again": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    },
    "Turn Bluetooth on to connect.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请打开蓝牙后再连接。"
          }
        }
      }
    },
    "Types this password when a window is asking for one. The lock screen always uses the system password.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有窗口等待密码时输入此处设置的密码。锁屏一律使用系统密码。"
          }
        }
      }
    },
    "Unlock Password": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁密码"
          }
        }
      }
    },
    "Unlock password": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁密码"
          }
        }
      }
    },
    "Unlock password not set": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未设置解锁密码"
          }
        }
      }
    },
    "Unlock password set": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁密码已设置"
          }
        }
      }
    },
    "Use 1 to %lld printable ASCII characters.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用 1 到 %lld 个可打印的 ASCII 字符。"
          }
        }
      }
    },
    "Use printable ASCII only, up to %lld characters.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅限可打印的 ASCII 字符，最多 %lld 个。"
          }
        }
      }
    },
    "Use the System Password": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改用系统密码"
          }
        }
      }
    },
    "Use this when the app cannot find the device, for example after pairing it again in Bluetooth settings. Nothing on the device is erased.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在应用找不到设备时使用，例如曾在系统蓝牙里重新配对过。不会清除设备中的任何数据。"
          }
        }
      }
    },
    "Uses the system password": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随系统密码"
          }
        }
      }
    },
    "Version": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本"
          }
        }
      }
    },
    "When the Dock icon is hidden, the app stays in the menu bar.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏程序坞图标后，应用只留在菜单栏。"
          }
        }
      }
    },
    "macOS has no keyboard for the device. Forget it in Bluetooth settings and pair it again.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 没有为设备创建键盘。请在蓝牙设置中忘记它，然后重新配对。"
          }
        }
      }
    },
    "macOS recognizes the device as a keyboard.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 已把设备识别为键盘。"
